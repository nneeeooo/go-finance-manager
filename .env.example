# Server
APP_HOST=localhost
APP_PORT=8080
APP_JWT_SECRET=replace_with_a_secure_random_base64_secret_key_min_32_chars==
GIN_MODE=debug

# PostgreSQL
POSTGRES_VERSION=17-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# pgAdmin (Optional)
PGADMIN_VERSION=9.17
PGADMIN_PORT=5454
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Monobank Importer
MONOBANK_API_URL=https://api.monobank.ua
MONOBANK_RATELIMIT=60
MONOBANK_TOKEN=your_monobank_token_here
MONOBANK_ACCOUNTS=account_id_1:black;account_id_2:white
MONOBANK_HISTORY_START=2024-01-01
MONOBANK_MAXSTATEMENTWINDOW=2682000

# Registration Whitelist (comma-separated)
ALLOWED_REGISTRATION_EMAILS=user@example.com

# Go tests
TEST_API_BASEURL=http://localhost:8080/api/v1
