# Build React SPA
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Set relative API path for production reverse proxy
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

# Nginx runtime
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
# Rendered at start by the image entrypoint (envsubst); local resolvers come from /etc/resolv.conf
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
